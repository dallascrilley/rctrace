{
  "name": "rctrace",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "blog:check": "node scripts/case-study.mjs",
    "blog:record": "node scripts/case-study-publish.mjs",
    "verify": "node scripts/verify.mjs",
    "dev": "node tools/static-server.mjs public 8787",
    "cibuild": "script/cibuild",
    "demo": "node tools/record-demo.mjs --serve public --steps docs/demo-steps.json --out docs/demo.gif --max-seconds 9"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
